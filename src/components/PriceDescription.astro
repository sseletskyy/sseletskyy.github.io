---
import type { PriceDescription } from '../data/types';

export type Props = {
  descriptionList: PriceDescription[];
};
const { descriptionList } = Astro.props as Props;
const isSingle = descriptionList.length === 1;
---

<>
  {
    isSingle ? (
      <section class="mx-auto flex max-w-3xl flex-col items-start gap-10 py-4 md:flex-row md:gap-16">
        <img
          class="w-full shrink-0 rounded-lg md:w-80"
          src={descriptionList[0].image.src}
          loading="lazy"
          decoding="async"
          alt={descriptionList[0].image.alt || ''}
        />
        <div class="flex flex-col gap-6">
          {descriptionList[0].title && <div class="text-xl font-semibold">{descriptionList[0].title}</div>}
          <div class="font-serif text-3xl font-medium">
            {descriptionList[0].oldPrice && <span class="pr-2 text-xl line-through opacity-50">{descriptionList[0].oldPrice}</span>}
            {descriptionList[0].price}
          </div>
          <div class="font-medium">Пакет включає в себе:</div>
          <ul class="flex list-disc flex-col gap-1 pl-5">
            {descriptionList[0].list.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        </div>
      </section>
    ) : (
      <section class="grid grid-cols-1 gap-2 md:grid-cols-3">
        {descriptionList.map((d) => (
          <div class="md-border-r flex flex-col gap-8 border-gray-500 pr-4">
            <div class="mx-auto">{d.title}</div>
            <div class="mx-auto">
              {d.oldPrice && <span class="pr-2 line-through">{d.oldPrice}</span>}
              {d.price}
            </div>
            <img class="mx-auto w-1/2 md:w-full" src={d.image.src} loading="lazy" decoding="async" alt={d.image.alt || ''} />
            <div>Пакет включає в себе:</div>
            <ul class="mx-auto list-disc md:px-4">
              {d.list.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }
  <!--<div class="my-16">* Ціни вказані для ознайомлення. Оплата послуг відбувається лише у національній валюті за курсом на день зйомки.</div>-->
</>
