---
import siteConfig from '../data/site-config';
---

<header class="mx-auto mb-12 w-full max-w-2xl sm:mb-16">
  {
    siteConfig.logo && siteConfig.logo?.src ? (
      <a class="text-theme-foreground font-serif text-2xl font-medium leading-tight sm:text-4xl" href="/">
        <img src={siteConfig.logo.src} alt={siteConfig.logo.alt || ''} class="__max-h-12" />
      </a>
    ) : (
      <a class="text-theme-foreground font-serif text-2xl font-medium leading-tight sm:text-4xl" href="/">
        {siteConfig.title}
      </a>
    )
  }
  {siteConfig.subtitle && <p class="text-md mt-1 pr-4 text-right leading-tight sm:pr-8">{siteConfig.subtitle}</p>}
</header>
