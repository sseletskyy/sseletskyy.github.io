---
import type { Testimonial } from '../data/testimonials';

export type Props = {
  testimonial: Testimonial;
};

const { testimonial } = Astro.props;
---

<div class="flex flex-col gap-3 p-6 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm">
  <div class="text-5xl font-serif leading-none text-gray-300 dark:text-gray-600 select-none">"</div>
  <p class="font-serif italic text-base leading-relaxed">{testimonial.text}</p>
</div>
