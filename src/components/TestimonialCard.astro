---
import type { Testimonial } from '../data/testimonials';

export type Props = {
  testimonial: Testimonial;
};

const { testimonial } = Astro.props;
---

<div class="flex flex-col gap-3 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-900">
  <div class="select-none font-serif text-5xl leading-none text-gray-300 dark:text-gray-600">"</div>
  <p class="font-serif text-base italic leading-relaxed">{testimonial.text}</p>
</div>
