---
import { marked } from 'marked';
import Button from './Button.astro';
import siteConfig from '../data/site-config';

const hero = siteConfig.hero;
---

{
  (hero?.title || hero?.image?.src || hero?.text || (hero?.actions && hero.actions.length > 0)) && (
    <section class="mb-16 w-full flex-col gap-8 sm:mb-24">
      {hero.title && <h1 class="font-serif text-3xl font-medium leading-tight sm:text-5xl sm:leading-tight">{hero.title}</h1>}
      {hero.text && <div class="prose prose-dante max-w-none sm:prose-lg" set:html={marked.parse(hero.text)} />}
      {hero.actions && hero.actions.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-4">
          {hero.actions.map((action) => (
            <Button href={action.href}>{action.text}</Button>
          ))}
        </div>
      )}
    </section>
  )
}
