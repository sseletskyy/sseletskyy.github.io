---
export type Props = {
  title: string;
  nbsp?: boolean;
};
const { title, nbsp = false } = Astro.props as Props;
const formattedTitle = nbsp ? title.split(' ').join('&nbsp;') : title;
---

<div class="title-shell mb-8">
  <h1 set:html={formattedTitle} class="title text-center font-serif text-3xl font-medium leading-tight sm:text-5xl sm:leading-tight" />
</div>
