---
const GA_ID = 'G-FBHMPJ80K3';
const AW_ID = 'AW-18184787596';
const AW_CONVERSION = 'AW-18184787596/HozYCLbaprIcEIytl99D';
---

<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script define:vars={{ GA_ID, AW_ID, AW_CONVERSION }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', GA_ID);
  gtag('config', AW_ID);

  window.gtag_report_conversion = function (url, channel) {
    if (channel) {
      gtag('event', 'contact_click', { method: channel });
    }
    var callback = function () {
      if (typeof url !== 'undefined') {
        window.location = url;
      }
    };
    gtag('event', 'conversion', {
      send_to: AW_CONVERSION,
      value: 1.0,
      currency: 'UAH',
      event_callback: callback,
    });
    return false;
  };
</script>
