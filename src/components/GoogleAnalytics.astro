---
// Replace GA_ID with the real G-XXXXXXXXXX Measurement ID from analytics.google.com
const GA_ID = 'G-FBHMPJ80K3';
---

<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>
