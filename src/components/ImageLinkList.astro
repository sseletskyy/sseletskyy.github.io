---
import type { ImageLink } from '../data/types';
export type Props = {
  list: ImageLink[];
};
const { list } = Astro.props as Props;
---

<div class="mx-auto">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      list.map((item) => (
        <div class="flex flex-col items-center gap-2">
          <a href={item.link.href}>
            <img src={item.image.src} alt={item.image.alt} class="h-auto w-full" />
          </a>
          <a
            href={item.link.href}
            class="block rounded-lg px-6 py-4 text-center font-bold uppercase shadow-lg hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-gray-600 focus:ring-opacity-50"
          >
            {item.link.text}
          </a>
        </div>
      ))
    }
  </div>
</div>
