---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../data/site-config';
import PageHeader from '../../components/PageHeader.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { testimonials } from '../../data/testimonials';

const { title } = siteConfig.testimonials;
const description = siteConfig.pageDescriptions?.testimonials ?? siteConfig.description;
---

<BaseLayout description={description} image={siteConfig.image} showHeader={false}>
  <PageHeader title={title} nbsp={false} />

  <section class="mx-auto mb-16 w-full max-w-3xl">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => <TestimonialCard testimonial={t} />)}
    </div>
  </section>
</BaseLayout>
