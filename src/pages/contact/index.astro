---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../data/site-config';
import PageHeader from '../../components/PageHeader.astro';
import { SocialIcon } from '../../components/SocialIcon';

const title = siteConfig.dictionaries.title.contact;
const description = siteConfig.pageDescriptions?.contact ?? siteConfig.description;
const socialLinks = siteConfig.socialLinks || [];
const instagram = socialLinks.find(({ text }) => text === 'Instagram');
const telegram = socialLinks.find(({ text }) => text === 'Telegram');
const viber = socialLinks.find(({ text }) => text === 'Viber');
---

<BaseLayout description={description} image={siteConfig.image} showHeader={false}>
  <PageHeader title={title} nbsp={false} />

  <section class="w-full max-w-3xl mx-auto pb-10 sm:pb-14 mt-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
      <a href="tel:+380679374999" class="flex flex-col items-center gap-3 p-6 rounded-xl border border-current hover:opacity-70 transition-opacity text-center">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"
          ></path>
        </svg>
        <div>
          <div class="font-bold mb-1">Телефон</div>
          <div class="text-lg underline">+38 067 937 4 999</div>
        </div>
      </a>

      {
        viber && (
          <a href={viber.href} class="flex flex-col items-center gap-3 p-6 rounded-xl border border-current hover:opacity-70 transition-opacity text-center">
            <SocialIcon className="w-8 h-8" socialName="Viber" client:load />
            <div>
              <div class="font-bold mb-1">Viber</div>
              <div class="text-sm">+38 067 937 4 999</div>
            </div>
          </a>
        )
      }

      {
        telegram && (
          <a
            href={telegram.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-3 p-6 rounded-xl border border-current hover:opacity-70 transition-opacity text-center"
          >
            <SocialIcon className="w-8 h-8" socialName="Telegram" client:load />
            <div>
              <div class="font-bold mb-1">Telegram</div>
              <div class="text-sm">@julia_seletska</div>
            </div>
          </a>
        )
      }
    </div>

    <div class="mb-10">
      <div class="font-bold mb-4">Соціальні мережі</div>
      <div class="flex flex-wrap gap-x-6 gap-y-3">
        {
          socialLinks.map((link) => (
            <a
              class="inline-flex items-center gap-2 text-sm hover:underline hover:underline-offset-2"
              href={link.href}
              target={link.text === 'Viber' ? '_self' : '_blank'}
              rel="noopener noreferrer"
            >
              <SocialIcon className="w-5 h-5" socialName={link.text} client:load />
              {link.text}
            </a>
          ))
        }
      </div>
    </div>

    <div class="max-w-prose">
      <p>Я завжди відкрита новим пропозиціям та творчим проєктам.</p>
      <br />
      <p>
        Якщо у вас є ідея фотографування — пишіть мені у Telegram, Viber або{' '}
        {
          instagram ? (
            <a
              class="inline-flex items-center gap-1 text-sm hover:underline hover:underline-offset-2"
              href={instagram.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          ) : (
            'Instagram'
          )
        }
        . Я буду рада втілити найбожевільнішу фотоідею.
      </p>
      <br />
      <p class="text-sm opacity-70">Відповідаю швидко — зазвичай протягом кількох годин.</p>
    </div>
  </section>
</BaseLayout>
